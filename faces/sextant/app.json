{
  "configVersion": "v3",
  "app": {
    "appId": 1131924,
    "appName": "Sextant",
    "appType": "watchface",
    "version": {
      "code": 2,
      "name": "1.1.0"
    },
    "icon": "icon.png",
    "vender": "raetha",
    "cover": [
      "cover.png"
    ],
    "description": "Sextant: a nautical, data-rich watch face with six editable complications, compass-tick gauges, automatic red night mode and a mono theme. Source: https://github.com/raetha/zepp-watch-faces"
  },
  "runtime": {
    "apiVersion": {
      "compatible": "4.2",
      "target": "4.2",
      "minVersion": "4.2"
    }
  },
  "permissions": [
    "data:user.hd.step",
    "data:user.hd.calorie",
    "data:user.hd.heart_rate",
    "data:user.hd.distance",
    "data:user.hd.pai",
    "data:user.hd.stand",
    "data:user.hd.fat_burning",
    "data:user.hd.spo2",
    "data:user.hd.stress",
    "data:user.hd.sleep",
    "data:user.hd.workout",
    "data:user.hd.body_temp",
    "device:os.barometer",
    "device:os.compass"
  ],
  "targets": {
    "common": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 1,
          "lockscreen": 1,
          "photoscreen": 0
        }
      },
      "platforms": [
        {
          "st": "r"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Sextant"
    },
    "zh-CN": {
      "appName": "Sextant"
    },
    "zh-TW": {
      "appName": "Sextant"
    }
  },
  "defaultLanguage": "en-US",
  "debug": false
}
